# ---- Claude (obligatorio para que el agente responda) ----
# Crea la clave en https://platform.claude.com/ -> API Keys
ANTHROPIC_API_KEY=

# Modelo del agente: claude-haiku-5-5 (barato), claude-sonnet-5-5 o claude-opus-5-5 (el más capaz y caro)
MODELO=claude-haiku-5-5
# Cuánto piensa antes de responder: low, medium (recomendado) o high
ESFUERZO=medium

# ---- WhatsApp Cloud API de Meta (déjalo vacío para probar solo con el simulador) ----
# Meta for Developers -> tu app -> WhatsApp -> Configuración de la API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Frase que tú inventas; debe ser la misma que escribes en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=agua-pruebas-2026
# Meta for Developers -> tu app -> Configuración -> Básica -> Clave secreta de la app
# Si la pones, el servidor rechaza webhooks que no vengan firmados por Meta (recomendado)
WHATSAPP_APP_SECRET=
GRAPH_VERSION=v23.0

# ---- WhatsApp por Twilio (sandbox, para probar mientras Meta aprueba) ----
# console.twilio.com -> página de inicio -> Account Info
TWILIO_ACCOUNT_SID=
# Si lo pones, el servidor rechaza webhooks que no vengan firmados por Twilio
TWILIO_AUTH_TOKEN=
# Número del sandbox, con el prefijo whatsapp:
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# URL pública de ngrok, sin barra final (Twilio firma sobre esa URL exacta)
PUBLIC_URL=

# ---- Servidor ----
PORT=3001
# Si la pones, el panel pide usuario "admin" y esta clave (ponla antes de exponerlo con ngrok)
PANEL_CLAVE=

# ---- Base de datos ----
# Por defecto data/lanuestra.db. Cambia la carpeta o el archivo si lo necesitas.
# DATA_DIR=
# DB_ARCHIVO=
